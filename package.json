{
  "name": "signaldesk-slack-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slack-native security incident agent with MCP-backed triage tools.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/slack/app.js",
    "mcp": "node src/mcp/server.js",
    "demo": "node scripts/demo.js",
    "demo:assets": "node scripts/export-demo-assets.js",
    "demo:preview:screenshot": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-demo-preview-screenshot.ps1",
    "demo:preview:check": "node scripts/demo-preview-check.js",
    "demo:thumbnail:check": "node scripts/thumbnail-check.js",
    "demo:captions:check": "node scripts/captions-check.js",
    "devpost:form:check": "node scripts/devpost-form-check.js",
    "rules:check": "node scripts/rules-compliance-check.js",
    "impact:evaluate": "node scripts/impact-evaluation.js",
    "judge:quickstart:check": "node scripts/judge-quickstart-check.js",
    "judge:matrix:check": "node scripts/judge-matrix-check.js",
    "prize:check": "node scripts/bonus-prize-check.js",
    "slack:ux:proof": "node scripts/slack-ux-proof.js",
    "slack:interactions:proof": "node scripts/slack-interaction-transcript.js",
    "check:syntax": "node scripts/syntax-check.js",
    "check:block-kit": "node scripts/slack-block-kit-check.js",
    "report:sample": "node scripts/sample-report.js",
    "proof:pack": "node scripts/proof-pack.js",
    "recording:check": "node scripts/recording-readiness.js",
    "repo:public:check": "node scripts/public-repo-check.js",
    "github:launch:check": "node scripts/github-launch-check.js",
    "github:launch:strict": "node scripts/github-launch-check.js --strict",
    "sandbox:doctor": "node scripts/slack-sandbox-doctor.js",
    "scan:secrets": "node scripts/secret-scan.js",
    "submission:check": "node scripts/submission-check.js",
    "submission:bundle": "node scripts/devpost-paste-bundle.js",
    "submission:set-urls": "node scripts/set-submission-urls.js",
    "submission:final:check": "node scripts/final-submission-check.js",
    "submission:final:online": "node scripts/final-submission-check.js --online",
    "validate:fixtures": "node scripts/validate-fixtures.js",
    "smoke:mcp": "node scripts/mcp-smoke.js",
    "smoke:slack-mcp": "node scripts/slack-mcp-bridge-smoke.js",
    "mcp:transcript": "node scripts/mcp-tool-transcript.js",
    "test": "node --test",
    "verify": "npm run scan:secrets && npm run check:syntax && npm run check:block-kit && npm run slack:ux:proof && npm run slack:interactions:proof && npm run demo:preview:check && npm run demo:thumbnail:check && npm run demo:captions:check && npm run devpost:form:check && npm run rules:check && npm run impact:evaluate && npm run recording:check && npm run judge:quickstart:check && npm run judge:matrix:check && npm run prize:check && npm run sandbox:doctor && npm run test && npm run smoke:mcp && npm run mcp:transcript && npm run smoke:slack-mcp && npm run validate:fixtures && npm run repo:public:check && npm run submission:bundle && npm run submission:check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@slack/bolt": "4.7.2",
    "zod": "4.4.3"
  }
}
